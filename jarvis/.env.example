# Kopiere diese Datei nach ".env" und trage deine Schlüssel ein.
# Die .env bleibt auf deinem Laptop und wird nie hochgeladen.

# Deepgram: https://console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=

# ElevenLabs: https://elevenlabs.io -> Profil -> API Keys
ELEVENLABS_API_KEY=

# Voice-ID von "Robert Ranger – Cool Storyteller" (siehe README, Abschnitt "Voice-ID finden")
ELEVENLABS_VOICE_ID=

# --- Optional ---
# Wie Jarvis dich ansprechen soll (leer lassen = ohne Namen)
USER_NAME=
# Port der lokalen Oberfläche
PORT=3000
# Browser beim Start automatisch öffnen (true/false)
OPEN_BROWSER=true
# Modelle (Standardwerte funktionieren ohne Änderung)
LISTEN_MODEL=nova-3
THINK_MODEL=gpt-4o-mini
ELEVENLABS_MODEL=eleven_turbo_v2_5
