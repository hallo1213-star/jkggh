# Nur für einen lokalen Test auf dem Laptop. Bei Render trägst du dieselben
# Werte im Dashboard unter "Environment" ein – nicht in eine Datei.

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Passwort für die Jarvis-App (mindestens 8 Zeichen, besser länger)
JARVIS_PASSWORD=

# Geheimer Schlüssel für den Laptop-Verbinder (lange zufällige Zeichenkette)
LAPTOP_TOKEN=

# --- Optional ---
USER_NAME=
PORT=3000
LISTEN_MODEL=nova-3
THINK_MODEL=gpt-4o-mini
ELEVENLABS_MODEL=eleven_turbo_v2_5
